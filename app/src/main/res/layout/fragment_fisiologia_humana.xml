                android:text="→ Produção de gametas:&#10;→ Espermatozoides (masculinos)&#10;→ Óvulos (femininos)&#10;→ Produção de hormônios sexuais&#10;→ Possibilitar a fecundação&#10;→ Permitir o desenvolvimento do embrião (no organismo feminino)"
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
