                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="O sistema reprodutor é responsável pela reprodução humana, garantindo a continuidade da espécie. Ele atua na produção das células sexuais (gametas), na secreção de hormônios sexuais e na criação das condições necessárias para que ocorra a fecundação e o desenvolvimento de um novo indivíduo."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Principais funções:"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/texto_primario" />
