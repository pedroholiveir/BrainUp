<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundocienciasnatureza"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-black"
            android:text="Ciências da Natureza"
            android:textColor="@color/texto_primario"
            android:textSize="34sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Escolha um conteúdo para estudar"
            android:textColor="@color/texto_secundario"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btfisica"
            style="@style/BrainUp.Botao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/cienciasnatureza"
            android:text="Física ▾" />
        <LinearLayout
            android:id="@+id/menufisica"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:visibility="gone">
            <Button
                android:id="@+id/btfcinematica"
                style="@style/BrainUp.Botao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/cienciasnatureza"
                android:text="Cinemática" />
            <Button
                android:id="@+id/btfnewton"
                style="@style/BrainUp.Botao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/cienciasnatureza"
                android:text="Leis de Newton" />
            <Button
                android:id="@+id/btfenergia"
                style="@style/BrainUp.Botao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/cienciasnatureza"
                android:text="Energia e Trabalho" />
            <Button
                android:id="@+id/btfeletricidade"
                style="@style/BrainUp.Botao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/cienciasnatureza"
                android:text="Eletricidade" />
        </LinearLayout>
        <Button
            android:id="@+id/btquimica"
            style="@style/BrainUp.Botao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/cienciasnatureza"
            android:text="Química ▾" />
        <LinearLayout
            android:id="@+id/menuquimica"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:visibility="gone">
            <Button
                android:id="@+id/btqatomistica"
                style="@style/BrainUp.Botao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/cienciasnatureza"
                android:text="Atomística e Tabela Periódica" />
            <Button
                android:id="@+id/btqligacoes"
                style="@style/BrainUp.Botao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/cienciasnatureza"
                android:text="Ligações Químicas" />
            <Button
                android:id="@+id/btqfuncoes"
                style="@style/BrainUp.Botao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/cienciasnatureza"
                android:text="Funções Inorgânicas e Reações" />
            <Button
                android:id="@+id/btqorganica"
                style="@style/BrainUp.Botao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/cienciasnatureza"
                android:text="Química Orgânica" />
        </LinearLayout>
        <Button
            android:id="@+id/btbiologia"
            style="@style/BrainUp.Botao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/cienciasnatureza"
            android:text="Biologia ▾" />
        <LinearLayout
            android:id="@+id/menubiologia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:visibility="gone">
            <Button
                android:id="@+id/btcitologia"
                style="@style/BrainUp.Botao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/cienciasnatureza"
                android:text="Citologia" />
            <Button
                android:id="@+id/btgenetica"
                style="@style/BrainUp.Botao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/cienciasnatureza"
                android:text="Genética" />
            <Button
                android:id="@+id/btevolucao"
                style="@style/BrainUp.Botao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/cienciasnatureza"
                android:text="Evolução" />
            <Button
                android:id="@+id/btecologia"
                style="@style/BrainUp.Botao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/cienciasnatureza"
                android:text="Ecologia" />
            <Button
                android:id="@+id/btbotanica"
                style="@style/BrainUp.Botao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/cienciasnatureza"
                android:text="Botânica" />
            <Button
                android:id="@+id/btfisiologia"
                style="@style/BrainUp.Botao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/cienciasnatureza"
                android:text="Fisiologia Humana" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
