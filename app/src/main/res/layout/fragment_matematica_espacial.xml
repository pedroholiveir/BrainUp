<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundomatematica">

    <TextView
        android:id="@+id/textView3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="35dp"
        android:layout_marginTop="35dp"
        android:layout_marginEnd="35dp"
        android:fontFamily="sans-serif-black"
        android:text="Geometria Espacial"
        android:textColor="@color/texto_primario"
        android:textSize="32sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/meuscrollview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@+id/btproximo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textView3">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

        <LinearLayout
            android:id="@+id/passo1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="Prismas e poliedros"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="→ Poliedro: sólido formado por faces planas, arestas e vértices. Relação de Euler (poliedros convexos): V − A + F = 2.&#10;→ Prisma: duas bases iguais e paralelas. Volume = área da base × altura.&#10;→ Paralelepípedo: V = a · b · c.&#10;→ Cubo de aresta a: V = a³ e área total = 6a²."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Unidades"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="1 m³ = 1.000 litros; 1 dm³ = 1 litro; 1 cm³ = 1 mililitro."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/passo2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="Cilindro"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="→ Volume: V = π · r² · h.&#10;→ Área lateral: 2 · π · r · h.&#10;→ Área total: 2 · π · r · (r + h)."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Exemplo"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="Cilindro com r = 3 cm e h = 10 cm (π = 3): V = 3 × 9 × 10 = 270 cm³."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/passo3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="Pirâmide, cone e esfera"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="→ Pirâmide: V = (1/3) · área da base · altura.&#10;→ Cone: V = (1/3) · π · r² · h, com geratriz g² = r² + h².&#10;→ Esfera: V = (4/3) · π · r³ e área da superfície = 4 · π · r²."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Exemplo"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="Cone com r = 3 cm e h = 4 cm (π = 3): V = (1/3) × 3 × 9 × 4 = 36 cm³."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/passo4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="Aplicações no ENEM"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="→ Capacidade de reservatórios, caixas-d'água e embalagens: calcule o volume e converta para litros.&#10;→ Efeito da escala: se a aresta de um cubo dobra, o volume fica 8 vezes maior; se o raio de um cilindro dobra (mesma altura), o volume fica 4 vezes maior.&#10;→ Planificações: imagine o sólido &quot;aberto&quot; para contar faces e conferir áreas."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Exemplo"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="Caixa-d'água cilíndrica com r = 1 m e h = 2 m (π = 3): V = 3 × 1 × 2 = 6 m³ = 6.000 litros."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
        </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <ImageButton
        android:id="@+id/btvoltar"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="50dp"
        android:layout_marginBottom="40dp"
        android:background="@drawable/botao_circular"
        android:backgroundTint="@color/azul_app"
        android:contentDescription="Passo anterior"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:scaleX="-1"
        android:src="@drawable/setadireita"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btproximo"
        style="@style/BrainUp.Botao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="40dp"
        android:backgroundTint="@color/azul_app"
        android:text="Próximo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
