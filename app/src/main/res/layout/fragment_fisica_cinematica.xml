<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundocienciasnatureza">

    <TextView
        android:id="@+id/textView3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="35dp"
        android:layout_marginTop="35dp"
        android:layout_marginEnd="35dp"
        android:fontFamily="sans-serif-black"
        android:text="Cinemática"
        android:textColor="@color/texto_primario"
        android:textSize="32sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/meuscrollview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@+id/btproximo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textView3">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

        <LinearLayout
            android:id="@+id/passo1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="Conceitos básicos"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="→ Referencial: ponto em relação ao qual se descreve o movimento. Repouso e movimento são relativos ao referencial.&#10;→ Posição, trajetória e deslocamento (variação da posição).&#10;→ Velocidade média = deslocamento ÷ tempo (Δs/Δt).&#10;→ Unidades: m/s e km/h. Para converter km/h em m/s, divida por 3,6; de m/s para km/h, multiplique por 3,6."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Exemplo"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="72 km/h ÷ 3,6 = 20 m/s."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/passo2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="Movimento uniforme (MU)"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="Velocidade constante e aceleração nula."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="→ Função horária: s = s₀ + v·t.&#10;→ Gráfico posição × tempo: reta inclinada.&#10;→ Gráfico velocidade × tempo: reta horizontal."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Exemplo"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="Um carro a 20 m/s, em movimento uniforme, percorre 20 × 15 = 300 m em 15 s."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/passo3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="Movimento uniformemente variado (MUV)"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="A aceleração é constante: a velocidade varia em quantidades iguais em tempos iguais."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="→ Aceleração: a = Δv/Δt (m/s²).&#10;→ Velocidade: v = v₀ + a·t.&#10;→ Posição: s = s₀ + v₀·t + a·t²/2.&#10;→ Equação de Torricelli: v² = v₀² + 2·a·Δs.&#10;→ No gráfico velocidade × tempo, a área sob a reta é o deslocamento."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Exemplo"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="Partindo do repouso com a = 2 m/s², após 5 s a velocidade é 2 × 5 = 10 m/s."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/passo4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="Queda livre e lançamentos"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="Na queda livre, só a gravidade atua. Nas provas usa-se g ≈ 10 m/s² (valor real: cerca de 9,8 m/s²)."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="→ Queda livre: v = g·t e h = g·t²/2.&#10;→ Sem resistência do ar, corpos de massas diferentes caem juntos.&#10;→ Lançamento vertical: no ponto mais alto, a velocidade é zero.&#10;→ Lançamento horizontal: na horizontal o movimento é uniforme; na vertical é queda livre."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Exemplo"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="Em 3 s de queda livre: h = 10 × 9 ÷ 2 = 45 m."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
        </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <ImageButton
        android:id="@+id/btvoltar"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="50dp"
        android:layout_marginBottom="40dp"
        android:background="@drawable/botao_circular"
        android:backgroundTint="@color/cienciasnatureza"
        android:contentDescription="Passo anterior"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:scaleX="-1"
        android:src="@drawable/setadireita"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btproximo"
        style="@style/BrainUp.Botao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="40dp"
        android:backgroundTint="@color/cienciasnatureza"
        android:text="Próximo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
