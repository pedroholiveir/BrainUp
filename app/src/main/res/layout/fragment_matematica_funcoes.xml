<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundomatematica">

    <TextView
        android:id="@+id/textView3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="35dp"
        android:layout_marginTop="35dp"
        android:layout_marginEnd="35dp"
        android:fontFamily="sans-serif-black"
        android:text="Funções"
        android:textColor="@color/texto_primario"
        android:textSize="32sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/meuscrollview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@+id/btproximo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textView3">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

        <LinearLayout
            android:id="@+id/passo1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="O que é uma função"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="Função é uma relação que associa cada valor x (variável independente) a um único valor y = f(x) (variável dependente)."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="→ Domínio: valores que x pode assumir. Imagem: valores que y assume.&#10;→ Exemplo do dia a dia: o preço de uma corrida de táxi, com bandeirada de R$ 5 e R$ 2 por km, é f(x) = 5 + 2x.&#10;→ O gráfico no plano cartesiano mostra como y varia em relação a x."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/passo2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="Função afim: f(x) = ax + b"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="→ O gráfico é uma reta.&#10;→ a (coeficiente angular) é a taxa de variação: se a &gt; 0 a função é crescente; se a &lt; 0, decrescente.&#10;→ b (coeficiente linear) é o valor de f(0), onde a reta corta o eixo y.&#10;→ Raiz: valor de x em que f(x) = 0, ou seja, x = −b/a."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Exemplo"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="f(x) = 2x − 6: é crescente, corta o eixo y em −6 e sua raiz é x = 3."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/passo3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="Função quadrática: f(x) = ax² + bx + c"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="→ O gráfico é uma parábola. Se a &gt; 0, a concavidade é para cima (ponto de mínimo); se a &lt; 0, para baixo (ponto de máximo).&#10;→ Raízes: Δ = b² − 4ac e x = (−b ± √Δ) ÷ 2a.&#10;→ Δ &gt; 0: duas raízes reais; Δ = 0: uma raiz; Δ &lt; 0: nenhuma raiz real.&#10;→ Vértice: xᵥ = −b/2a e yᵥ = −Δ/4a (é onde ocorre o máximo ou o mínimo)."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Exemplo"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="x² − 5x + 6 = 0: Δ = 25 − 24 = 1, então x = (5 ± 1)/2, ou seja, x = 3 ou x = 2."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/passo4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="Exponencial e logaritmo (noções)"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="→ Função exponencial f(x) = aˣ modela crescimentos e decaimentos muito rápidos: juros compostos, populações, desintegração radioativa.&#10;→ Logaritmo é a operação inversa: log₍ₐ₎ b = x significa aˣ = b.&#10;→ Exemplo: log₁₀ 100 = 2, pois 10² = 100."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Lendo gráficos no ENEM"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="Identifique o que cada eixo representa, em quais intervalos a função cresce ou decresce, onde estão os valores máximos e mínimos e qual é a taxa de variação."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
        </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <ImageButton
        android:id="@+id/btvoltar"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="50dp"
        android:layout_marginBottom="40dp"
        android:background="@drawable/botao_circular"
        android:backgroundTint="@color/azul_app"
        android:contentDescription="Passo anterior"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:scaleX="-1"
        android:src="@drawable/setadireita"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btproximo"
        style="@style/BrainUp.Botao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="40dp"
        android:backgroundTint="@color/azul_app"
        android:text="Próximo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
