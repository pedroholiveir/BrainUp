<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundoportugues">

    <TextView
        android:id="@+id/textView3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="35dp"
        android:layout_marginTop="35dp"
        android:layout_marginEnd="35dp"
        android:fontFamily="sans-serif-black"
        android:text="Coesão e Coerência"
        android:textColor="@color/texto_primario"
        android:textSize="32sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/meuscrollview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@+id/btproximo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textView3">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

        <LinearLayout
            android:id="@+id/passo1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="Coesão e coerência"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="→ Coerência: sentido global do texto. As ideias são lógicas, não se contradizem e combinam com o tema e a situação.&#10;→ Coesão: ligação entre as partes do texto, feita por conectivos, pronomes, sinônimos e outros recursos."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="Um texto pode ser coeso e incoerente: tem bons conectivos, mas ideias que se contradizem ou fogem do tema."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/passo2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="Coesão referencial"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="Retoma ou antecipa elementos já citados para evitar repetições."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="→ Pronomes: &quot;Maria chegou cedo. Ela organizou tudo.&quot;&#10;→ Sinônimos e expressões equivalentes: &quot;o presidente… o chefe de Estado&quot;.&#10;→ Hiperônimos: &quot;o cachorro… o animal&quot;.&#10;→ Elipse: omissão de um termo que se subentende."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/passo3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="Coesão sequencial: os conectivos"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="→ Adição: e, além disso, também.&#10;→ Oposição: mas, porém, contudo, todavia, no entanto.&#10;→ Causa: porque, pois, visto que, já que.&#10;→ Conclusão: portanto, logo, assim, por isso.&#10;→ Concessão: embora, apesar de, ainda que.&#10;→ Condição: se, caso, desde que.&#10;→ Finalidade: para que, a fim de.&#10;→ Exemplificação: por exemplo.&#10;→ Tempo: quando, enquanto, depois que."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="Escolher o conectivo errado muda o sentido: &quot;Estudou muito; portanto não passou&quot; é incoerente, pois pede &quot;mas&quot; ou &quot;no entanto&quot;."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/passo4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="Aplicando na redação"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="→ A Competência 4 do ENEM avalia o uso de elementos coesivos entre frases e parágrafos.&#10;→ Ligue os parágrafos com marcadores: &quot;Em primeiro lugar&quot;, &quot;Além disso&quot;, &quot;Por fim&quot;, &quot;Portanto&quot;.&#10;→ Evite repetir a mesma palavra ou o mesmo conectivo muitas vezes.&#10;→ Cuidado com contradições e com a fuga ao tema, que afetam a coerência."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Dica"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="Releia o texto e pergunte, a cada parágrafo, qual relação ele tem com o anterior: adição, oposição, causa, conclusão. Se não houver relação clara, falta coesão."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
        </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <ImageButton
        android:id="@+id/btvoltar"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="50dp"
        android:layout_marginBottom="40dp"
        android:background="@drawable/botao_circular"
        android:backgroundTint="@color/portugues"
        android:contentDescription="Passo anterior"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:scaleX="-1"
        android:src="@drawable/setadireita"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btproximo"
        style="@style/BrainUp.Botao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="40dp"
        android:backgroundTint="@color/portugues"
        android:text="Próximo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
