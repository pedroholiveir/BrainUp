<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundocienciashumanas">

    <TextView
        android:id="@+id/textView3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="35dp"
        android:layout_marginTop="35dp"
        android:layout_marginEnd="35dp"
        android:fontFamily="sans-serif-black"
        android:text="Cartografia"
        android:textColor="@color/texto_primario"
        android:textSize="32sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/meuscrollview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@+id/btproximo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textView3">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

        <LinearLayout
            android:id="@+id/passo1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="Orientação e coordenadas geográficas"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="→ Pontos cardeais: Norte, Sul, Leste (nascente) e Oeste (poente). A rosa dos ventos também traz os pontos colaterais (NE, SE, SO, NO).&#10;→ Latitude: distância angular em relação ao Equador (0°), de 0° a 90° para o Norte ou para o Sul. Os paralelos são as linhas de latitude.&#10;→ Longitude: distância angular em relação ao meridiano de Greenwich (0°), de 0° a 180° para Leste ou para Oeste. Os meridianos são as linhas de longitude."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="O Equador divide a Terra em hemisfério Norte e Sul; Greenwich divide em hemisfério Leste e Oeste."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/passo2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="Fusos horários"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="A Terra gira 360° em 24 horas, então cada fuso horário tem 15° de longitude e diferença de 1 hora para o vizinho."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="→ Para o Leste, as horas avançam (+).&#10;→ Para o Oeste, as horas atrasam (−)."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Exemplo"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="Se em Greenwich são 12h, três fusos a leste são 15h; três fusos a oeste são 9h."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/passo3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="Escala"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="A escala indica a relação entre a distância no mapa e a distância real. Na escala numérica 1:50.000, 1 cm no mapa equivale a 50.000 cm (500 m) no terreno."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="→ Quanto menor o denominador, maior a escala e mais detalhes o mapa mostra (1:10.000 é maior que 1:1.000.000).&#10;→ Escala gráfica: barra com as distâncias já convertidas."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Como calcular"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="Distância real = distância no mapa × denominador da escala. Exemplo: 5 cm em 1:50.000 = 250.000 cm = 2,5 km."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/passo4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="Projeções cartográficas"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="Como a Terra é uma esfera, qualquer mapa plano distorce alguma coisa: áreas, formas, distâncias ou ângulos."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="→ Mercator (cilíndrica): conserva os ângulos e é útil para navegação, mas aumenta muito as áreas em altas latitudes (a Groenlândia parece enorme).&#10;→ Peters (cilíndrica): conserva as proporções de área, mas deforma as formas.&#10;→ Azimutal (polar) e cônica: usadas para representar regiões específicas."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/passo5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="Mapas e tecnologias"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="→ Mapas físicos, políticos e temáticos (população, clima, economia).&#10;→ Curvas de nível: linhas que ligam pontos de mesma altitude e mostram o relevo.&#10;→ Legenda: explica os símbolos e as cores usados.&#10;→ Sensoriamento remoto: imagens de satélite para monitorar desmatamento, cidades e clima.&#10;→ GPS: localização por satélites.&#10;→ SIG (geoprocessamento): cruza dados em camadas sobre o mapa."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
        </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <ImageButton
        android:id="@+id/btvoltar"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="50dp"
        android:layout_marginBottom="40dp"
        android:background="@drawable/botao_circular"
        android:backgroundTint="@color/cienciashumanas"
        android:contentDescription="Passo anterior"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:scaleX="-1"
        android:src="@drawable/setadireita"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btproximo"
        style="@style/BrainUp.Botao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="40dp"
        android:backgroundTint="@color/cienciashumanas"
        android:text="Próximo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
