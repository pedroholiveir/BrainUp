<?xml version="1.0" encoding="utf-8"?>
<!--
  Responsividade: mesma estrutura da tela de redação.
  - fitsSystemWindows: respeita barra de status e de navegação (edge-to-edge).
  - Coluna central com largura máxima de 640dp (tablet / celular na horizontal).
  - Nota total com auto-ajuste de tamanho (não estoura com fonte grande do sistema).
  - Botões com wrap_content + minHeight do estilo do app.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundoApp"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/colunaResultado"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="640dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-black"
                android:text="Resultado"
                android:textColor="@color/texto_primario"
                android:textSize="34sp" />

            <TextView
                android:id="@+id/textTemaResultado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/texto_secundario"
                android:textSize="16sp"
                android:textStyle="italic" />

            <TextView
                android:id="@+id/textNotaTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:autoSizeMaxTextSize="48sp"
                android:autoSizeMinTextSize="28sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:maxLines="1"
                android:text="0 / 1000"
                android:textColor="@color/azul_escuro"
                android:textSize="48sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Estimativa feita por IA, apenas para treino. A nota oficial pode ser diferente."
                android:textColor="@color/texto_secundario"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/listaCompetencias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_redacao"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="✅ Pontos fortes"
                    android:textColor="@color/texto_primario"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textFortes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/texto_primario"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_redacao"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎯 O que melhorar"
                    android:textColor="@color/texto_primario"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textMelhorias"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/texto_primario"
                    android:textSize="16sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btVoltarTexto"
                style="@style/BrainUp.Botao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/azul_app"
                android:text="Voltar ao texto" />

            <Button
                android:id="@+id/btInicioRedacao"
                style="@style/BrainUp.Botao.Secundario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:text="Ir para o início" />

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
