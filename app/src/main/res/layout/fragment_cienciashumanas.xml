<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundocienciashumanas"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-black"
            android:text="Ciências Humanas"
            android:textColor="@color/texto_primario"
            android:textSize="34sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Escolha um conteúdo para estudar"
            android:textColor="@color/texto_secundario"
            android:textSize="16sp" />

        <Button
            android:id="@+id/bthistoria"
            style="@style/BrainUp.Botao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/cienciashumanas"
            android:text="História ▾" />
        <LinearLayout
            android:id="@+id/menuhistoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:visibility="gone">
            <Button
                android:id="@+id/bthcolonia"
                style="@style/BrainUp.Botao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/cienciashumanas"
                android:text="Brasil Colônia" />
            <Button
                android:id="@+id/bthimperio"
                style="@style/BrainUp.Botao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/cienciashumanas"
                android:text="Brasil Império" />
            <Button
                android:id="@+id/bthrepublica"
                style="@style/BrainUp.Botao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/cienciashumanas"
                android:text="Brasil República" />
            <Button
                android:id="@+id/bthmundo"
                style="@style/BrainUp.Botao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/cienciashumanas"
                android:text="Mundo Contemporâneo" />
        </LinearLayout>
        <Button
            android:id="@+id/btgeografia"
            style="@style/BrainUp.Botao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/cienciashumanas"
            android:text="Geografia ▾" />
        <LinearLayout
            android:id="@+id/menugeografia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:visibility="gone">
            <Button
                android:id="@+id/btgcartografia"
                style="@style/BrainUp.Botao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/cienciashumanas"
                android:text="Cartografia" />
            <Button
                android:id="@+id/btgclima"
                style="@style/BrainUp.Botao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/cienciashumanas"
                android:text="Clima e Biomas do Brasil" />
            <Button
                android:id="@+id/btgpopulacao"
                style="@style/BrainUp.Botao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/cienciashumanas"
                android:text="População, Cidades e Globalização" />
        </LinearLayout>
        <Button
            android:id="@+id/btfilosofia"
            style="@style/BrainUp.Botao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/cienciashumanas"
            android:text="Filosofia ▾" />
        <LinearLayout
            android:id="@+id/menufilosofia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:visibility="gone">
            <Button
                android:id="@+id/btfiloIntro"
                style="@style/BrainUp.Botao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/cienciashumanas"
                android:text="Introdução à Filosofia" />
            <Button
                android:id="@+id/btpensadores"
                style="@style/BrainUp.Botao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/cienciashumanas"
                android:text="Pensadores Clássicos" />
            <Button
                android:id="@+id/btetica"
                style="@style/BrainUp.Botao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/cienciashumanas"
                android:text="Ética" />
            <Button
                android:id="@+id/btpolitica"
                style="@style/BrainUp.Botao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/cienciashumanas"
                android:text="Política" />
            <Button
                android:id="@+id/btpoliticaatual"
                style="@style/BrainUp.Botao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/cienciashumanas"
                android:text="Política Atual" />
        </LinearLayout>
        <Button
            android:id="@+id/btsociologia"
            style="@style/BrainUp.Botao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/cienciashumanas"
            android:text="Sociologia ▾" />
        <LinearLayout
            android:id="@+id/menusociologia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:visibility="gone">
            <Button
                android:id="@+id/btsintro"
                style="@style/BrainUp.Botao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/cienciashumanas"
                android:text="Introdução à Sociologia" />
            <Button
                android:id="@+id/btscultura"
                style="@style/BrainUp.Botao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/cienciashumanas"
                android:text="Cultura e Diversidade" />
            <Button
                android:id="@+id/btstrabalho"
                style="@style/BrainUp.Botao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="@color/cienciashumanas"
                android:text="Trabalho, Desigualdade e Cidadania" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
