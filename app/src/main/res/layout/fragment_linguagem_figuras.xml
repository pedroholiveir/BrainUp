<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundoportugues">

    <TextView
        android:id="@+id/textView3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="35dp"
        android:layout_marginTop="35dp"
        android:layout_marginEnd="35dp"
        android:fontFamily="sans-serif-black"
        android:text="Figuras de Linguagem"
        android:textColor="@color/texto_primario"
        android:textSize="32sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/meuscrollview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@+id/btproximo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textView3">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

        <LinearLayout
            android:id="@+id/passo1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="Figuras de palavras"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="→ Comparação: aproxima dois elementos com um conectivo. &quot;Forte como um touro.&quot;&#10;→ Metáfora: comparação sem conectivo. &quot;Ele é uma fera na matemática.&quot;&#10;→ Metonímia: troca de uma palavra por outra com a qual tem relação (autor pela obra, parte pelo todo). &quot;Li Machado de Assis&quot; (= li a obra dele).&#10;→ Catacrese: uso de uma palavra por falta de termo específico. &quot;Pé da mesa&quot;, &quot;braço da cadeira&quot;.&#10;→ Sinestesia: mistura de sensações de sentidos diferentes. &quot;Voz aveludada&quot;, &quot;cheiro doce&quot;.&#10;→ Antonomásia: substitui o nome por uma característica. &quot;O Rei do Futebol.&quot;"
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/passo2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="Figuras de pensamento"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="→ Antítese: aproxima ideias opostas. &quot;Amor e ódio.&quot;&#10;→ Paradoxo: ideia aparentemente contraditória, mas com sentido. &quot;Silêncio ensurdecedor.&quot;&#10;→ Hipérbole: exagero para dar ênfase. &quot;Estou morrendo de fome.&quot;&#10;→ Eufemismo: suaviza uma ideia desagradável. &quot;Partiu desta para melhor&quot; (= morreu).&#10;→ Ironia: dizer o contrário do que se pensa, geralmente para criticar. &quot;Que ótimo!&quot; ao ver o carro quebrado.&#10;→ Personificação (prosopopeia): atribui características humanas a seres não humanos. &quot;O vento sussurrava segredos.&quot;&#10;→ Gradação: sequência de ideias em ordem crescente ou decrescente."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/passo3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="Figuras de sintaxe e de som"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="→ Elipse: omissão de um termo que se subentende.&#10;→ Pleonasmo: repetição de ideia para reforçar o sentido. &quot;Vi com meus próprios olhos.&quot;&#10;→ Inversão (hipérbato): alteração da ordem natural das palavras.&#10;→ Aliteração: repetição de sons consonantais. &quot;O rato roeu a roupa do rei de Roma.&quot;&#10;→ Assonância: repetição de sons vocálicos.&#10;→ Onomatopeia: palavra que imita um som. &quot;Tic-tac&quot;, &quot;miau&quot;."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/passo4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="Como cai no ENEM"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="A pergunta quase sempre é sobre o efeito da figura no texto. Responda a duas coisas: qual é a figura e por que o autor a usou."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="→ Ironia → crítica, humor ou contestação.&#10;→ Hipérbole → ênfase, dramatização.&#10;→ Metáfora → relação criativa que amplia o sentido.&#10;→ Eufemismo → atenuar algo desagradável ou polêmico.&#10;→ Antítese e paradoxo → destacar conflitos e contradições."
                android:textSize="18sp"
                android:textColor="@color/texto_primario" />
        </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <ImageButton
        android:id="@+id/btvoltar"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="50dp"
        android:layout_marginBottom="40dp"
        android:background="@drawable/botao_circular"
        android:backgroundTint="@color/portugues"
        android:contentDescription="Passo anterior"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:scaleX="-1"
        android:src="@drawable/setadireita"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btproximo"
        style="@style/BrainUp.Botao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="40dp"
        android:backgroundTint="@color/portugues"
        android:text="Próximo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
