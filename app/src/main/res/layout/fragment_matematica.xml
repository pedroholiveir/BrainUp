<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundomatematica"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-black"
            android:text="Matemática"
            android:textColor="@color/texto_primario"
            android:textSize="34sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Escolha um conteúdo para estudar"
            android:textColor="@color/texto_secundario"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btmproporcao"
            style="@style/BrainUp.Botao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/azul_app"
            android:text="Razão, Proporção e Regra de Três" />
        <Button
            android:id="@+id/btmporcentagem"
            style="@style/BrainUp.Botao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/azul_app"
            android:text="Porcentagem e Juros" />
        <Button
            android:id="@+id/btalgebra"
            style="@style/BrainUp.Botao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/azul_app"
            android:text="Álgebra" />
        <Button
            android:id="@+id/btmfuncoes"
            style="@style/BrainUp.Botao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/azul_app"
            android:text="Funções" />
        <Button
            android:id="@+id/btgeometriaplana"
            style="@style/BrainUp.Botao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/azul_app"
            android:text="Geometria Plana" />
        <Button
            android:id="@+id/btmespacial"
            style="@style/BrainUp.Botao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/azul_app"
            android:text="Geometria Espacial" />
        <Button
            android:id="@+id/btmtrigonometria"
            style="@style/BrainUp.Botao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/azul_app"
            android:text="Trigonometria" />
        <Button
            android:id="@+id/btmestatistica"
            style="@style/BrainUp.Botao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/azul_app"
            android:text="Estatística" />
        <Button
            android:id="@+id/btmprobabilidade"
            style="@style/BrainUp.Botao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/azul_app"
            android:text="Probabilidade e Contagem" />
    </LinearLayout>
</ScrollView>
